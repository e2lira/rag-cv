APP_ENV=dev
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ragcv
DATABASE_MAINTENANCE_URL=postgresql://postgres:<password>@localhost:5432/postgres

# Capa de proveedores de modelo (RFC-0013 4). LLM_TEMPERATURE y
# LLM_MAX_TOKENS son comunes a las tres ramas.
PROVEEDOR=anthropic
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Apagado por defecto (RFC-0013 6.1, ADR-0005): vacio, salvo designacion
# explicita de un proveedor secundario (bedrock | anthropic |
# openai_compatible, distinto de PROVEEDOR).
PROVEEDOR_FALLBACK=
# Solo si PROVEEDOR=bedrock o PROVEEDOR_FALLBACK=bedrock -- ausentes en
# esta PoC (RFC-0018, RFC-0016 7).
# AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Solo si PROVEEDOR=openai_compatible o PROVEEDOR_FALLBACK=openai_compatible.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
# OPENAI_COMPATIBLE_MODEL_ID=deepseek-chat

EMBEDDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
EMBEDDING_DIM=1536

CORPUS_PATH=corpus/cv.md
EMBED_MAX_TOKENS=1800

# Sondeo del corpus (RFC-0019 8). WATCHER_CADENCE la ejecuta el cron del VPS
# (RFC-0020), la aplicacion no la lee.
WATCHER_CADENCE=*/5 * * * *
WATCHER_STABILITY_DELAY_SECONDS=5
WATCHER_LEASE_SECONDS=600
WATCHER_MAX_ATTEMPTS=5
WATCHER_HEARTBEAT_MAX_AGE_SECONDS=900

# Recuperacion hibrida (RFC-0003 5, 3.4).
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RETRIEVAL_EF_SEARCH=40
RRF_K=60
RETRIEVAL_MIN_SCORE=0.016
RETRIEVAL_TIMEOUT_MS=2000
RETRIEVAL_CONTEXT_BUDGET=2500
RRF_WEIGHT_SEMANTIC=1.0
RRF_WEIGHT_LEXICAL=1.0

# API REST (RFC-0005). COMMIT_SHA lo escribe el despliegue con el commit
# validado en verde (RFC-0020 6): el VPS no tiene el repositorio, asi que
# /readyz no puede consultar `git` en tiempo de ejecucion.
COMMIT_SHA=
# Las claves se guardan HASHEADAS en SHA-256 (RFC-0005 6.1). El valor en
# claro no se escribe en ningun archivo del repositorio: se entrega al
# cliente una sola vez y se descarta. Sin ninguna clave activa el proceso
# no arranca (CA-25) -- una API cuyo unico efecto posible es 401 no esta
# lista.
API_KEYS_JSON={"keys":[{"id":"demo","hash":"<sha256-de-la-clave>","role":"read","label":"demo","active":true,"expires_at":null}]}
# Cuota por cubeta fija anclada al dia UTC (ADR-0016).
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=1000
# Lista blanca separada por comas, VACIA por defecto (RFC-0005 9, A-8): la
# v1 no tiene frontend propio, y abrir `*` seria regalar la clave al
# primero que inspeccione una pagina.
CORS_ALLOWED_ORIGINS=

PYTHONUTF8=1

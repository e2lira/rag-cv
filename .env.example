APP_ENV=dev
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ragcv
DATABASE_MAINTENANCE_URL=postgresql://postgres:<password>@localhost:5432/postgres

PROVEEDOR=anthropic
ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

EMBEDDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
EMBEDDING_DIM=1536

CORPUS_PATH=corpus/cv.md
EMBED_MAX_TOKENS=1800

# Sondeo del corpus (RFC-0019 8). WATCHER_CADENCE la ejecuta el cron del VPS
# (RFC-0020), la aplicacion no la lee.
WATCHER_CADENCE=*/5 * * * *
WATCHER_STABILITY_DELAY_SECONDS=5
WATCHER_LEASE_SECONDS=600
WATCHER_MAX_ATTEMPTS=5
WATCHER_HEARTBEAT_MAX_AGE_SECONDS=900
PYTHONUTF8=1

# Rotacion de la bitacora del sondeo -- RFC-0020 CA-18.
#
# Se instala en /etc/logrotate.d/rag-cv (requiere privilegios, una vez).
#
# Un log que crece sin tope llena el disco del VPS, y el sintoma NO es "falta
# el log": es que PostgreSQL deja de poder escribir. El fallo aparece lejos de
# su causa, que es lo que lo hace caro.
#
# La API no escribe aqui -- va a `journalctl --user -u rag-cv-api`, que systemd
# ya rota por su cuenta. Esto es solo para el sondeo de RFC-0019, que corre
# desde el cron y redirige su salida a fichero.

/opt/rag-cv/logs/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    # El fichero rotado conserva al duenio: si logrotate lo recreara como
    # root, el sondeo -- que corre sin privilegios -- no podria escribir y
    # dejaria de registrar sin emitir ningun error.
    create 0640 qrimapp-reto qrimapp-reto
    su qrimapp-reto qrimapp-reto
}
